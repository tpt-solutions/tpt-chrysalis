# tpt-chrysalis Helm Secrets Values - Example
# Copy to values-secrets.yaml and fill in actual values
# NEVER commit actual secrets to git!

global:
  # Capability token root signing key (Ed25519 private key, base64 encoded)
  # Generate with: openssl rand -hex 32 | base64
  capabilityRootKey: ""

  # MinIO credentials
  minioRootUser: ""
  minioRootPassword: ""

# tpt-archon secrets (mounted as files)
tpt-archon:
  env:
    ARCHON_CAPABILITY_ROOT_KEY_FILE: /secrets/capability_root_key

# API secrets
api:
  env:
    CAPABILITY_ROOT_KEY_FILE: /secrets/capability_root_key
    MINIO_ACCESS_KEY: "{{ .Values.global.minioRootUser }}"
    MINIO_SECRET_KEY: "{{ .Values.global.minioRootPassword }}"

# Secrets (referenced by deployments)
secrets:
  capabilityRootKey: ""
  minioRootUser: ""
  minioRootPassword: ""