# tpt-chrysalis-api Dockerfile - Multi-stage build
# Build stage
FROM rust:1.85-bookworm AS builder

WORKDIR /workspace

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy workspace files for dependency caching
COPY Cargo.toml Cargo.lock ./
COPY crates/tpt-chrysalis-core/Cargo.toml crates/tpt-chrysalis-core/
COPY crates/tpt-chrysalis-hal/Cargo.toml crates/tpt-chrysalis-hal/
COPY crates/tpt-chrysalis-sim/Cargo.toml crates/tpt-chrysalis-sim/
COPY crates/tpt-chrysalis-safety/Cargo.toml crates/tpt-chrysalis-safety/
COPY crates/tpt-chrysalis-orchestrator/Cargo.toml crates/tpt-chrysalis-orchestrator/
COPY crates/tpt-chrysalis-compliance/Cargo.toml crates/tpt-chrysalis-compliance/
COPY crates/tpt-chrysalis-api/Cargo.toml crates/tpt-chrysalis-api/

# Create dummy source files to cache dependencies
RUN mkdir -p crates/tpt-chrysalis-core/src \
    crates/tpt-chrysalis-hal/src \
    crates/tpt-chrysalis-sim/src \
    crates/tpt-chrysalis-safety/src \
    crates/tpt-chrysalis-orchestrator/src \
    crates/tpt-chrysalis-compliance/src \
    crates/tpt-chrysalis-api/src \
    && echo "// dummy" > crates/tpt-chrysalis-core/src/lib.rs \
    && echo "// dummy" > crates/tpt-chrysalis-hal/src/lib.rs \
    && echo "// dummy" > crates/tpt-chrysalis-sim/src/lib.rs \
    && echo "// dummy" > crates/tpt-chrysalis-safety/src/lib.rs \
    && echo "// dummy" > crates/tpt-chrysalis-orchestrator/src/lib.rs \
    && echo "// dummy" > crates/tpt-chrysalis-compliance/src/lib.rs \
    && echo "// dummy" > crates/tpt-chrysalis-api/src/lib.rs \
    && echo 'fn main() {}' > crates/tpt-chrysalis-api/src/main.rs

# Build dependencies
RUN cargo build --release --workspace --exclude tpt-chrysalis-hal 2>/dev/null || true

# Copy actual source
COPY crates/ crates/

# Build the API binary
RUN cargo build --release --bin tpt-chrysalis-api

# Runtime stage
FROM debian:bookworm-slim AS runtime

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libssl3 \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy binary
COPY --from=builder /workspace/target/release/tpt-chrysalis-api /app/tpt-chrysalis-api

# Create non-root user
RUN useradd -r -s /bin/false -u 10001 appuser && \
    chown -R appuser:appuser /app

USER appuser

EXPOSE 3000

HEALTHCHECK --interval=10s --timeout=5s --retries=5 --start-period=10s \
    CMD curl -f http://localhost:3000/health || exit 1

ENTRYPOINT ["/app/tpt-chrysalis-api"]

# Development stage (for docker-compose.override.yml)
FROM builder AS dev

RUN cargo install cargo-watch

WORKDIR /workspace

ENTRYPOINT ["cargo", "watch", "-x", "run --bin tpt-chrysalis-api"]