# tpt-chrysalis Environment Variables - Local Development
# Copy to .env and fill in values

# tpt-archon
ARCHON_KERNEL_BIND=0.0.0.0:50051
ARCHON_STORAGE_BIND=0.0.0.0:50052
ARCHON_RELATIONAL_BIND=0.0.0.0:50053
ARCHON_WAL_DIR=/data/wal
ARCHON_DB_DIR=/data/db
ARCHON_CAPABILITY_ROOT_KEY_FILE=/secrets/capability_root_key

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# API
API_BIND=0.0.0.0:3000
ARCHON_KERNEL_ENDPOINT=http://localhost:50051
ARCHON_STORAGE_ENDPOINT=http://localhost:50052
ARCHON_RELATIONAL_ENDPOINT=http://localhost:50053
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=chrysalis-imaging
CAPABILITY_ROOT_KEY_FILE=./secrets/capability_root_key
DEFAULT_SCOPE=equipment/sim-liquid-handler-0

# Frontend
TRUNK_PORT=8080
API_BASE=http://localhost:3000/api/v1

# Logging
RUST_LOG=info